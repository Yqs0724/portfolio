---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import TimelineItem from '../components/TimelineItem.astro';
import profile from '../data/profile.json';
---

<BaseLayout title={profile.siteTitle}>
  <section
    class="flex flex-col-reverse items-center gap-8 py-14 text-center sm:py-20 md:flex-row md:justify-between md:text-left"
  >
    <div class="max-w-xl space-y-5" data-reveal>
      <h1 class="text-4xl font-bold leading-tight text-ink sm:text-5xl">{profile.siteTitle}</h1>
      <p class="text-lg text-ink/80">{profile.tagline}</p>
      <div class="flex flex-wrap justify-center gap-3 md:justify-start">
        <a
          href="/projects/"
          class="rounded-full bg-primary px-6 py-2.5 font-medium text-ink transition hover:bg-primary-deep"
        >
          {profile.hero.ctaPrimary}
        </a>
        <a
          href="#contact"
          class="rounded-full border border-primary px-6 py-2.5 font-medium text-primary-deep transition hover:bg-primary/15"
        >
          {profile.hero.ctaSecondary}
        </a>
      </div>
    </div>
    <div class="shrink-0" data-reveal>
      <img
        src={profile.avatar}
        alt={profile.avatarAlt}
        width="224"
        height="224"
        class="h-40 w-40 rounded-full border-4 border-white object-cover shadow-[0_4px_16px_rgba(248,165,184,0.25)] sm:h-56 sm:w-56"
      />
    </div>
  </section>

  <section class="py-8">
    <h2 class="mb-6 text-2xl font-bold text-ink" data-reveal>{profile.aboutTitle}</h2>
    <div
      class="space-y-4 rounded-xl border border-line bg-card p-6 shadow-[0_4px_16px_rgba(248,165,184,0.25)] sm:p-8"
      data-reveal
    >
      {profile.aboutParagraphs.map((paragraph) => <p class="leading-relaxed text-ink">{paragraph}</p>)}
    </div>

    <h2 class="mb-6 mt-10 text-2xl font-bold text-ink" data-reveal>{profile.timelineTitle}</h2>
    <ul class="max-w-2xl" data-reveal>
      {
        profile.timeline.map((entry, index) => (
          <TimelineItem entry={entry} isLast={index === profile.timeline.length - 1} />
        ))
      }
    </ul>

    <h2 class="mb-4 mt-10 text-2xl font-bold text-ink" data-reveal>{profile.skillsTitle}</h2>
    <ul class="flex flex-wrap gap-3" data-reveal>
      {
        profile.skills.map((skill) => (
          <li class="rounded-full border border-primary bg-primary/15 px-4 py-1.5 text-sm font-medium text-primary-deep">
            {skill}
          </li>
        ))
      }
    </ul>

    <ContactSection
      id="contact"
      title={profile.contactTitle}
      email={profile.email}
      github={profile.github}
      labels={profile.labels}
    />
  </section>
</BaseLayout>
