---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links: NavLink[];
  siteName: string;
}

const { links, siteName } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath;
---

<header class="sticky top-0 z-10 border-b border-line bg-white/80 backdrop-blur">
  <nav class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="text-lg font-bold text-primary-deep">{siteName}</a>
    <ul class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-1.5 text-sm transition',
                isActive(link.href)
                  ? 'bg-primary/20 font-semibold text-primary-deep'
                  : 'text-ink hover:text-primary-deep',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
